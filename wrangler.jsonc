{
  "name": "polla-mundial",
  "main": "functions/api/sync-user.ts",
  "compatibility_date": "2026-05-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CLERK_PUBLISHABLE_KEY": "pk_test_c3Rlcmxpbmctc2N1bHBpbi02My5jbGVyay5hY2NvdW50cy5kZXYk"
  },
  "d1_databases": [
    {
      "binding": "mundial2026db",
      "database_name": "mundial2026db",
      "database_id": "d42ce1f0-1666-41ba-bb20-1b88ad4ce89a"
    }
  ],
    "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
